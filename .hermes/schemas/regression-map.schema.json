{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saasweave.local/hermes/regression-map.schema.json",
  "title": "Hermes regression map",
  "type": "object",
  "required": ["version", "entries"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "affected", "risk", "verification"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "affected": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "risk": { "enum": ["low", "medium", "high", "critical"] },
          "verification": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "status": { "enum": ["open", "mitigated", "accepted"] }
        }
      }
    }
  }
}
