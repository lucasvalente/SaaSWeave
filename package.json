{
  "name": "autuax",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "db:generate": "turbo --filter=@autuax/database db:generate",
    "db:migrate": "turbo --filter=@autuax/database db:migrate",
    "db:status": "turbo --filter=@autuax/database db:status",
    "hermes:status": "node scripts/hermes-status.mjs",
    "hermes:run": "node scripts/hermes-run.mjs",
    "hermes:v3:test": "node scripts/hermes-v3-tests.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.4.2",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
