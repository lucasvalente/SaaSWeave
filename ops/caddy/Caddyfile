	email {$ACME_EMAIL:admin@zapdisparo.com}
}

# Produção com certificado HTTPS automático (Let's Encrypt / ZeroSSL)
{$APP_DOMAIN:app.zapdisparo.com} {
	encode zstd gzip

	@api path /api /api/*
	handle @api {
		uri strip_prefix /api
		reverse_proxy api:3333
	}

	handle {
		reverse_proxy web:80
	}
}

# Acesso direto pelo IP com fallback HTTP
http://37.60.237.117 {
	encode zstd gzip

	@api path /api /api/*
	handle @api {
		uri strip_prefix /api
		reverse_proxy api:3333
	}

	handle {
		reverse_proxy web:80
	}
}
