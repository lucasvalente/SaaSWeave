# Copy to a host-only .env.production file (permissions 0600). Do not commit it.
# Validate before deployment: pnpm ops:production-env-validate .env.production
APP_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com
VITE_WEB_URL=https://app.example.com
VITE_SERVER_URL=https://app.example.com/server
MEDIA_PUBLIC_BASE_URL=https://app.example.com/server/media
MINIO_PUBLIC_BASE_URL=https://app.example.com/uploads
VITE_IMGPROXY_URL=https://app.example.com/img

# Immutable release identifier, normally a full Git commit SHA or image digest.
SOURCE_COMMIT=replace-with-release-revision

POSTGRES_USER=saasweave
POSTGRES_PASSWORD=replace-with-a-unique-long-database-password
POSTGRES_DB=saasweave
DATABASE_URL=postgresql://saasweave:replace-with-a-unique-long-database-password@postgres:5432/saasweave
REDIS_URL=redis://redis:6379/0
NODE_ENV=production
REQUIRE_EMAIL_VERIFICATION=true
PLATFORM_ADMIN_EMAILS=admin@example.com

# Generate unique secrets locally. Each must be at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-unique-32-character-or-longer-secret
RUNTIME_CONTROLLER_TOKEN=replace-with-a-unique-32-character-or-longer-secret
METRICS_BEARER_TOKEN=replace-with-a-unique-32-character-or-longer-secret

MAIL_PROVIDER=resend
MAIL_FROM=SaaSWeave <ops@example.com>
RESEND_API_KEY=replace-with-resend-api-key
# For SMTP instead, set MAIL_PROVIDER=smtp, SMTP_URL, and leave RESEND_API_KEY empty.
SMTP_URL=

MINIO_BUCKET=uploads
MINIO_ACCESS_KEY_ID=replace-with-minio-access-key
MINIO_SECRET_ACCESS_KEY=replace-with-minio-secret-key

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICES={}
STRIPE_METERS={}
CACHE_PREFIX=saasweave
CACHE_DEFAULT_TTL_SECONDS=300
QUEUE_PREFIX=saasweave
WORKER_CONCURRENCY=5
METRICS_ENABLED=true
OTEL_TRACE_SAMPLE_RATE=0.1
RETENTION_PURGE_DRY_RUN=false
RETENTION_LEGAL_HOLD_ORG_IDS=
SECURITY_CSP_REPORT_URI=
