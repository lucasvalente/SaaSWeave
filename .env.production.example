# ==============================================================================
# AUTUAX - PRODUCTION ENVIRONMENT CONFIGURATION
# Copie este arquivo para .env.production na sua VPS e preencha senhas seguras.
# Exemplo: cp .env.production.example .env.production
# ==============================================================================

# Application Environment
NODE_ENV=production
APP_VERSION=0.1.0
LOG_LEVEL=info

# Ports Mapping
API_PORT=3333
WEB_PORT=80

# PostgreSQL 16 Credentials
POSTGRES_DB=autuax
POSTGRES_USER=autuax
POSTGRES_PASSWORD=defina_uma_senha_forte_aqui_para_o_postgres

# Redis 7 Password
REDIS_PASSWORD=defina_uma_senha_forte_aqui_para_o_redis
